# ---- AI service (FastAPI) configuration ----
# Copy to .env and fill in your key.

# LLM provider — OpenAI-compatible. Defaults target OpenRouter (free models available).
# OpenRouter: https://openrouter.ai/keys   |  OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint.
#   OpenRouter (recommended, free models): https://openrouter.ai/api/v1
#   OpenAI:                                  https://api.openai.com/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model id. Must support tool/function calling.
#   OpenRouter free w/ tools:  openai/gpt-4o-mini  (cheap) | google/gemini-2.0-flash-exp:free
#   OpenAI direct:             gpt-4o-mini
AI_MODEL=openai/gpt-4o-mini

# Where the Express backend (Phase 2) lives — the AI tools call these endpoints.
BACKEND_API_URL=http://localhost:4000

# Allowed CORS origin (the Next.js app).
CORS_ORIGIN=http://localhost:3000

# Port for this FastAPI service.
PORT=8000
