# Oracle connection (node-oracledb Thin mode — no Oracle client install required)
# Local Docker XE example below. Copy this file to ".env" and fill in real values.

ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
# Easy Connect string: host:port/serviceName
# Docker XE 21c default service for the pluggable DB is XEPDB1
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Oracle Cloud Autonomous DB (later) uses a wallet — set these instead:
# ORACLE_CONNECT_STRING=your_tns_alias
# TNS_ADMIN=./wallet

PORT=4000
# Comma-separated list of allowed origins for CORS (the Next.js dev server)
CORS_ORIGIN=http://localhost:3000
