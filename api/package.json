{
  "name": "nps-portal-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express + node-oracledb API wrapping the NPS Portal PL/SQL procedures",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "oracledb": "^6.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/oracledb": "^6.10.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
